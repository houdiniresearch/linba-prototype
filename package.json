{
  "name": "linba-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/domain.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "test:header": "node --import tsx --test tests/header.test.ts",
    "test:waitlist": "node --import tsx --test tests/public-waitlist.test.ts",
    "test:voice": "node --import tsx tests/voice-smoke.ts",
    "test:rehearsal": "node --env-file=.env.local --import tsx tests/rehearsal-dialogue-eval.ts",
    "test:rehearsal:audio": "node --env-file=.env.local --import tsx tests/rehearsal-audio-smoke.ts",
    "format": "prettier --write app components lib tests *.md docs/*.md",
    "test:report-assistant": "node --import tsx --test tests/report-chat.test.ts",
    "test:report-assistant:integration": "node --import tsx tests/report-assistant.integration.ts",
    "test:landing": "node --import tsx --test tests/landing.test.ts",
    "test:product": "node --import tsx --test tests/product-ui.test.ts",
    "test:practice-workspace": "node --import tsx --test tests/practice-workspace.test.ts",
    "test:activity-library": "node --import tsx --test tests/activity-library.test.ts",
    "test:slide-order": "node --import tsx --test tests/slide-order.test.ts",
    "test:practice-workspace:integration": "node --import tsx tests/practice-workspace.integration.ts",
    "test:routes": "node --import tsx --test tests/routes.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "next": "^16.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "werift": "^0.25.0"
  }
}
