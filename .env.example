OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE_MODEL=gpt-realtime-2.1
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
# Voice and structured text tasks use independent transports/models.
OPENAI_TEXT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Use sqlite only for isolated offline tests or explicit local development.
LINBA_DATABASE=supabase
SUPABASE_URL=
# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional per-task overrides: OPENAI_ANSWER_MODEL, OPENAI_VERIFY_MODEL,
# OPENAI_GROUP_MODEL, OPENAI_PERSONAS_MODEL, OPENAI_ACTIVITY_MODEL,
# OPENAI_REPORT_MODEL, OPENAI_REPORT_CHAT_MODEL.
